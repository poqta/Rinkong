<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="652.0" prefWidth="1039.0" style="-fx-background-color: linear-gradient(to bottom right, #DCEAF0, #EEF4F7); -fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.rinkong.controller.ReservaController">

    <children>

        <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="INICIO  ›  RESERVAS" textFill="#94A3B8" />

        <Label layoutX="30.0" layoutY="43.0" style="-fx-font-size: 27px; -fx-font-weight: bold;" text="Gestión de reservas" textFill="#1E3A4C" />

        <Label layoutX="31.0" layoutY="87.0" style="-fx-font-size: 13px;" text="Registre y administre las reservas de habitaciones del hotel" textFill="#64748B" />

        <Pane layoutX="830.0" layoutY="29.0" prefHeight="42.0" prefWidth="179.0" style="-fx-background-color: white;                      -fx-background-radius: 22;                      -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 8, 0, 0, 2);">

            <children>

                <Circle fill="#D08A3C" layoutX="18.0" layoutY="21.0" radius="4.0" />

                <Label layoutX="31.0" layoutY="13.0" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Módulo de reservas" textFill="#1E3A4C" />
            </children>
        </Pane>

        <Pane layoutX="30.0" layoutY="125.0" prefHeight="495.0" prefWidth="320.0" style="-fx-background-color: white;                      -fx-background-radius: 14;                      -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 12, 0, 0, 3);">

            <children>

                <ImageView fitHeight="38.0" fitWidth="38.0" layoutX="22.0" layoutY="17.0" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@img/logo.png" />
                    </image>
                    <clip>
                        <Rectangle arcHeight="10.0" arcWidth="10.0" height="38.0" width="38.0" />
                    </clip>
                </ImageView>

                <Label layoutX="72.0" layoutY="17.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Datos de la reserva" textFill="#1E3A4C" />

                <Label layoutX="72.0" layoutY="40.0" style="-fx-font-size: 11px;" text="Complete los datos del formulario" textFill="#94A3B8" />

                <Separator layoutX="22.0" layoutY="73.0" opacity="0.5" prefWidth="276.0" />

                <Label layoutX="22.0" layoutY="84.0" style="-fx-font-size: 10px; -fx-font-weight: bold;" text="HABITACIÓN" textFill="#64748B" />

                <ComboBox fx:id="cmbHabitacion" layoutX="22.0" layoutY="102.0" prefHeight="32.0" prefWidth="276.0" promptText="Seleccione una habitación" style="-fx-background-color: #F8FAFC;                                  -fx-border-color: #E2E8F0;                                  -fx-border-radius: 8;                                  -fx-background-radius: 8;" />

                <Label layoutX="22.0" layoutY="143.0" style="-fx-font-size: 10px; -fx-font-weight: bold;" text="HUÉSPED" textFill="#64748B" />

                <ComboBox fx:id="cmbHuesped" layoutX="22.0" layoutY="161.0" prefHeight="32.0" prefWidth="276.0" promptText="Seleccione un huésped" style="-fx-background-color: #F8FAFC;                                  -fx-border-color: #E2E8F0;                                  -fx-border-radius: 8;                                  -fx-background-radius: 8;" />

                <Label layoutX="22.0" layoutY="202.0" style="-fx-font-size: 10px; -fx-font-weight: bold;" text="FECHA DE ENTRADA" textFill="#64748B" />

                <DatePicker fx:id="dpFechaEntrada" layoutX="22.0" layoutY="220.0" prefHeight="32.0" prefWidth="276.0" promptText="Seleccione la fecha" style="-fx-background-color: #F8FAFC;                                    -fx-border-color: #E2E8F0;                                    -fx-border-radius: 8;                                    -fx-background-radius: 8;" />

                <Label layoutX="22.0" layoutY="261.0" style="-fx-font-size: 10px; -fx-font-weight: bold;" text="FECHA DE SALIDA" textFill="#64748B" />

                <DatePicker fx:id="dpFechaSalida" layoutX="22.0" layoutY="279.0" prefHeight="32.0" prefWidth="276.0" promptText="Seleccione la fecha" style="-fx-background-color: #F8FAFC;                                    -fx-border-color: #E2E8F0;                                    -fx-border-radius: 8;                                    -fx-background-radius: 8;" />

                <Label layoutX="22.0" layoutY="320.0" style="-fx-font-size: 10px; -fx-font-weight: bold;" text="ESTADO DE LA RESERVA" textFill="#64748B" />

                <ComboBox fx:id="cmbEstado" layoutX="22.0" layoutY="338.0" prefHeight="32.0" prefWidth="276.0" promptText="Seleccione un estado" style="-fx-background-color: #F8FAFC;                                  -fx-border-color: #E2E8F0;                                  -fx-border-radius: 8;                                  -fx-background-radius: 8;" />

                <Button fx:id="btnGuardar" layoutX="22.0" layoutY="380.0" onAction="#Guardar" prefHeight="36.0" prefWidth="276.0" style="-fx-background-color: #44778B;                                -fx-background-radius: 8;                                -fx-text-fill: white;                                -fx-font-size: 12px;                                -fx-font-weight: bold;                                -fx-cursor: hand;" text="Guardar reserva" />

                <Button fx:id="btnActualizar" layoutX="22.0" layoutY="425.0" onAction="#Actualizar" prefHeight="34.0" prefWidth="132.0" style="-fx-background-color: #2E9E8F;                                -fx-background-radius: 8;                                -fx-text-fill: white;                                -fx-font-size: 12px;                                -fx-font-weight: bold;                                -fx-cursor: hand;" text="Actualizar" />

                <Button fx:id="btnCancelar" layoutX="166.0" layoutY="425.0" onAction="#Cancelar" prefHeight="34.0" prefWidth="132.0" style="-fx-background-color: #C95A5A;                                -fx-background-radius: 8;                                -fx-text-fill: white;                                -fx-font-size: 12px;                                -fx-font-weight: bold;                                -fx-cursor: hand;" text="Cancelar reserva" />

            </children>
        </Pane>

        <Pane layoutX="370.0" layoutY="125.0" prefHeight="495.0" prefWidth="650.0" style="-fx-background-color: white;                      -fx-background-radius: 14;                      -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 12, 0, 0, 3);">

            <children>

                <Label layoutX="22.0" layoutY="21.0" style="-fx-font-size: 17px; -fx-font-weight: bold;" text="Reservas registradas" textFill="#1E3A4C" />

                <Label layoutX="22.0" layoutY="48.0" style="-fx-font-size: 11px;" text="Seleccione una fila para editar o cancelar una reserva" textFill="#94A3B8" />

                <Button fx:id="btnLimpiar" layoutX="473.0" layoutY="24.0" onAction="#Limpiar" prefHeight="32.0" prefWidth="155.0" style="-fx-background-color: white;                                -fx-border-color: #CBD5E1;                                -fx-border-radius: 8;                                -fx-background-radius: 8;                                -fx-text-fill: #475569;                                -fx-font-size: 11px;                                -fx-cursor: hand;" text="Limpiar formulario" />

                <Separator layoutX="22.0" layoutY="84.0" opacity="0.5" prefWidth="606.0" />

                <TableView fx:id="tablaReservas" layoutX="22.0" layoutY="100.0" prefHeight="340.0" prefWidth="606.0" style="-fx-background-color: white;                                   -fx-border-color: #E2E8F0;                                   -fx-border-radius: 8;                                   -fx-font-size: 12px;">

                    <columns>
                        <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />

                        <TableColumn fx:id="colHabitacion" prefWidth="105.0" text="Habitación" />

                        <TableColumn fx:id="colHuesped" prefWidth="130.0" text="Huésped" />

                        <TableColumn fx:id="colFechaEntrada" prefWidth="100.0" text="Entrada" />

                        <TableColumn fx:id="colFechaSalida" prefWidth="100.0" text="Salida" />

                        <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                    </columns>

                    <placeholder>
                        <Label text="No hay reservas registradas" textFill="#94A3B8" />
                    </placeholder>

                </TableView>

                <Label fx:id="lblMensaje" layoutX="24.0" layoutY="458.0" prefWidth="595.0" style="-fx-font-size: 12px;" textFill="#44778B" wrapText="true" />

            </children>
        </Pane>

    </children>

</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox spacing="22.0"
      style="-fx-background-color: linear-gradient(to bottom right, #DCEAF0, #EEF4F7); -fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.rinkong.controller.HabitacionController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
    </padding>

    <!-- ===================== ENCABEZADO ===================== -->
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4.0">
            <Label text="INICIO  ›  HABITACIONES" textFill="#94A3B8"
                   style="-fx-font-size: 11px; -fx-font-weight: bold;" />
            <Label text="Gestión de habitaciones" textFill="#1E3A4C"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;" />
            <Label text="Registre, consulte, actualice y elimine las habitaciones del hotel" textFill="#64748B"
                   style="-fx-font-size: 14px;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="8.0" left="14.0" right="16.0" top="8.0" />
            </padding>
            <Circle fill="#44778B" radius="4.0" />
            <Label text="Módulo de habitaciones" textFill="#1E293B" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
        </HBox>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

        <!-- ===================== FORMULARIO ===================== -->
        <VBox spacing="16.0" prefWidth="320.0" minWidth="290.0"
              style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 3);">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane>
                    <ImageView fitHeight="38.0" fitWidth="38.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@img/logo.png" />
                        </image>
                        <clip>
                            <Rectangle arcHeight="12.0" arcWidth="12.0" height="38.0" width="38.0" />
                        </clip>
                    </ImageView>
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="Datos de la habitación" textFill="#1E3A4C"
                           style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                    <Label text="Complete todos los campos" textFill="#94A3B8" style="-fx-font-size: 12px;" />
                </VBox>
            </HBox>

            <Separator opacity="0.5" />

            <VBox spacing="6.0">
                <Label text="NÚMERO" textFill="#64748B" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="txtNumero" prefHeight="40.0" promptText="Ej. 101"
                           style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12 0 12;" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="TIPO" textFill="#64748B" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="txtTipo" prefHeight="40.0" promptText="Ej. Doble"
                           style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12 0 12;" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="PRECIO POR NOCHE" textFill="#64748B" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <TextField fx:id="txtPrecio" prefHeight="40.0" promptText="Ej. 85.00"
                           style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12 0 12;" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="ESTADO" textFill="#64748B" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <ComboBox fx:id="cbEstado" maxWidth="Infinity" prefHeight="40.0" promptText="Seleccione un estado"
                          style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" />
            </VBox>

            <Region prefHeight="4.0" />

            <!-- Acciones -->
            <Button fx:id="btnGuardar" maxWidth="Infinity" mnemonicParsing="false" onAction="#Guardar"
                    prefHeight="42.0" text="Guardar habitación"
                    style="-fx-background-color: #44778B; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" />

            <HBox spacing="10.0">
                <Button fx:id="btnActualizar" maxWidth="Infinity" mnemonicParsing="false" onAction="#Actualizar"
                        prefHeight="40.0" text="Actualizar" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #2E9E8F; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" />
                <Button fx:id="btnEliminar" maxWidth="Infinity" mnemonicParsing="false" onAction="#Eliminar"
                        prefHeight="40.0" text="Eliminar" HBox.hgrow="ALWAYS"
                        style="-fx-background-color: #C95A5A; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" />
            </HBox>

            <Button fx:id="btnLimpiar" maxWidth="Infinity" mnemonicParsing="false" onAction="#Limpiar"
                    prefHeight="40.0" text="Limpiar formulario"
                    style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-cursor: hand;" />

            <Label fx:id="lblMensaje" maxWidth="Infinity" textFill="#44778B" wrapText="true"
                   style="-fx-font-size: 12px;" />
        </VBox>

        <!-- ===================== TABLA ===================== -->
        <VBox spacing="14.0" HBox.hgrow="ALWAYS" maxWidth="Infinity"
              style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 3);">
            <padding>
                <Insets bottom="20.0" left="22.0" right="22.0" top="22.0" />
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2.0">
                    <Label text="Habitaciones registradas" textFill="#1E3A4C"
                           style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                    <Label text="Seleccione una fila para editarla o eliminarla" textFill="#94A3B8"
                           style="-fx-font-size: 12px;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                        <Circle fill="#2E9E8F" radius="4.0" />
                        <Label text="Disponible" textFill="#64748B" style="-fx-font-size: 11px;" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                        <Circle fill="#D08A3C" radius="4.0" />
                        <Label text="Ocupada" textFill="#64748B" style="-fx-font-size: 11px;" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                        <Circle fill="#C95A5A" radius="4.0" />
                        <Label text="Mantenimiento" textFill="#64748B" style="-fx-font-size: 11px;" />
                    </HBox>
                </HBox>
            </HBox>

            <TableView fx:id="tablaHabitaciones" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <placeholder>
                    <Label text="No hay habitaciones registradas" textFill="#94A3B8" style="-fx-font-size: 13px;" />
                </placeholder>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60.0" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colNumero" text="Número" prefWidth="100.0" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="140.0" style="-fx-alignment: CENTER_LEFT;" />
                    <TableColumn fx:id="colPrecio" text="Precio / noche" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" />
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="130.0" style="-fx-alignment: CENTER;" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
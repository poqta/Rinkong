<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox spacing="22.0" style="-fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial; -fx-background-color: linear-gradient(to bottom right, #DCEAF0, #EEF4F7);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.rinkong.controller.HabitacionController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4.0">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="INICIO  ›  HABITACIONES" textFill="#94A3B8" />
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Gestión de habitaciones" textFill="#1E3A4C" />
            <Label style="-fx-font-size: 14px;" text="Registre, consulte, actualice y elimine las habitaciones del hotel" textFill="#64748B" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="8.0" left="14.0" right="16.0" top="8.0" />
            </padding>
            <Circle fill="#44778B" radius="4.0" />
            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Módulo de habitaciones" textFill="#1E293B" />
        </HBox>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

        <VBox minWidth="290.0" prefWidth="320.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 3);">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane>
                    <ImageView fitHeight="38.0" fitWidth="38.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@img/logo.png" />
                        </image>
                        <clip>
                            <Rectangle arcHeight="12.0" arcWidth="12.0" height="38.0" width="38.0" />
                        </clip>
                    </ImageView>
                </StackPane>
                <VBox spacing="1.0">
                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold;" text="Datos de la habitación" textFill="#1E3A4C" />
                    <Label style="-fx-font-size: 12px;" text="Complete todos los campos" textFill="#94A3B8" />
                </VBox>
            </HBox>

            <Separator opacity="0.5" />

            <VBox spacing="6.0">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="NÚMERO" textFill="#64748B" />
                <TextField fx:id="txtNumero" prefHeight="40.0" promptText="Ej. 101" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12 0 12;" />
            </VBox>

            <VBox spacing="6.0">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="TIPO" textFill="#64748B" />
                <TextField fx:id="txtTipo" prefHeight="40.0" promptText="Ej. Doble" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12 0 12;" />
            </VBox>

            <VBox spacing="6.0">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="PRECIO POR NOCHE" textFill="#64748B" />
                <TextField fx:id="txtPrecio" prefHeight="40.0" promptText="Ej. 85.00" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12 0 12;" />
            </VBox>

            <VBox spacing="6.0">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="ESTADO" textFill="#64748B" />
                <ComboBox fx:id="cbEstado" maxWidth="Infinity" prefHeight="40.0" promptText="Seleccione un estado" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" />
            </VBox>

            <Region prefHeight="4.0" />

            <Button fx:id="btnGuardar" maxWidth="Infinity" mnemonicParsing="false" onAction="#Guardar" prefHeight="42.0" style="-fx-background-color: #44778B; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="Guardar habitación" />

            <HBox spacing="10.0">
                <Button fx:id="btnActualizar" maxWidth="Infinity" mnemonicParsing="false" onAction="#Actualizar" prefHeight="40.0" style="-fx-background-color: #2E9E8F; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="Actualizar" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnEliminar" maxWidth="Infinity" mnemonicParsing="false" onAction="#Eliminar" prefHeight="40.0" style="-fx-background-color: #C95A5A; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="Eliminar" HBox.hgrow="ALWAYS" />
            </HBox>

            <Button fx:id="btnLimpiar" maxWidth="Infinity" mnemonicParsing="false" onAction="#Limpiar" prefHeight="40.0" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-cursor: hand;" text="Limpiar formulario" />

            <Label fx:id="lblMensaje" maxWidth="Infinity" style="-fx-font-size: 12px;" textFill="#44778B" wrapText="true" />
        </VBox>

        <VBox maxWidth="Infinity" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 3);" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="22.0" right="22.0" top="22.0" />
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2.0">
                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold;" text="Habitaciones registradas" textFill="#1E3A4C" />
                    <Label style="-fx-font-size: 12px;" text="Seleccione una fila para editarla o eliminarla" textFill="#94A3B8" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                        <Circle fill="#2E9E8F" radius="4.0" />
                        <Label style="-fx-font-size: 11px;" text="Disponible" textFill="#64748B" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                        <Circle fill="#D08A3C" radius="4.0" />
                        <Label style="-fx-font-size: 11px;" text="Ocupada" textFill="#64748B" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                        <Circle fill="#C95A5A" radius="4.0" />
                        <Label style="-fx-font-size: 11px;" text="Mantenimiento" textFill="#64748B" />
                    </HBox>
                </HBox>
            </HBox>

            <TableView fx:id="tablaHabitaciones" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 13px;" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <placeholder>
                    <Label style="-fx-font-size: 13px;" text="No hay habitaciones registradas" textFill="#94A3B8" />
                </placeholder>
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60.0" style="-fx-alignment: CENTER;" text="ID" />
                    <TableColumn fx:id="colNumero" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Número" />
                    <TableColumn fx:id="colTipo" prefWidth="140.0" style="-fx-alignment: CENTER_LEFT;" text="Tipo" />
                    <TableColumn fx:id="colPrecio" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Precio / noche" />
                    <TableColumn fx:id="colEstado" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Estado" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>

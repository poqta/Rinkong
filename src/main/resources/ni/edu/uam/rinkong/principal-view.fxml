<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="680.0" prefWidth="1120.0" style="-fx-background-color: #F1F5F9; -fx-font-family: 'Segoe UI', 'Helvetica Neue', Arial;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.rinkong.controller.PrincipalController">

    <left>
        <VBox prefWidth="250.0" spacing="6.0" style="-fx-background-color: linear-gradient(to bottom, #1E3A4C, #24475A);">
            <padding>
                <Insets bottom="22.0" left="18.0" right="18.0" top="26.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane>
                    <ImageView fitHeight="44.0" fitWidth="44.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@img/logo.png" />
                        </image>
                        <clip>
                            <Rectangle arcHeight="14.0" arcWidth="14.0" height="44.0" width="44.0" />
                        </clip>
                    </ImageView>
                </StackPane>
                <VBox spacing="1.0">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="RINKONG" textFill="WHITE" />
                    <Label style="-fx-font-size: 11px;" text="Hotel · Sistema de reservas" textFill="#9FBFCC" />
                </VBox>
            </HBox>

            <Region prefHeight="18.0" />
            <Separator opacity="0.25" />
            <Region prefHeight="14.0" />

            <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="MENÚ PRINCIPAL" textFill="#7FA3B3">
                <VBox.margin>
                    <Insets bottom="6.0" left="8.0" />
                </VBox.margin>
            </Label>

            <Button fx:id="btnInicio" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#Inicio" prefHeight="46.0" prefWidth="214.0" style="-fx-background-color: #44778B; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 0 18; -fx-cursor: hand;" text="Inicio" />
            <Button fx:id="btnHabitaciones" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#Habitaciones" prefHeight="43.0" prefWidth="214.0" style="-fx-background-color: #44778B; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 0 18; -fx-cursor: hand;" text="Habitaciones" >
                <VBox.margin><Insets top="11.0" /></VBox.margin>
            </Button>
            <Button fx:id="btnHuespedes" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#Huespedes" prefHeight="44.0" style="-fx-background-color: #44778B; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 0 18; -fx-cursor: hand;" text="Huéspedes" >
                <VBox.margin><Insets top="11.0" /></VBox.margin>
            </Button>
            <Button fx:id="btnReservas" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#Reservas" prefHeight="44.0" style="-fx-background-color: #44778B; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 0 18; -fx-cursor: hand;" text="Reservas" >
                <VBox.margin><Insets top="11.0" /></VBox.margin>
            </Button>

            <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="SISTEMA" textFill="#7FA3B3">
                <VBox.margin>
                    <Insets bottom="6.0" left="8.0" top="18.0" />
                </VBox.margin>
            </Label>
            <Button fx:id="btnConcurrencia" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#Concurrencia" prefHeight="44.0" style="-fx-background-color: #44778B; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 0 18; -fx-cursor: hand;" text="Concurrencia" />

            <Region VBox.vgrow="ALWAYS" />

            <VBox fx:id="Uam" spacing="2.0" style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 10;">
                <padding>
                    <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
                </padding>
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Rinkong · UAM" textFill="WHITE" />
                <Label style="-fx-font-size: 11px;" text="Versión 1.0" textFill="#9FBFCC" />
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenidoPrincipal">
            <VBox spacing="24.0">
                <padding>
                    <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
                </padding>

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4.0">
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Panel de administración" textFill="#1E3A4C" />
                        <Label style="-fx-font-size: 14px;" text="Bienvenido al sistema de reservas Rinkong" textFill="#64748B" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 10, 0, 0, 2);">
                        <padding>
                            <Insets bottom="6.0" left="6.0" right="16.0" top="6.0" />
                        </padding>
                        <StackPane>
                            <ImageView fitHeight="32.0" fitWidth="32.0" preserveRatio="true" smooth="true">
                                <image>
                                    <Image url="@img/logo.png" />
                                </image>
                                <clip>
                                    <Circle centerX="16.0" centerY="16.0" radius="16.0" />
                                </clip>
                            </ImageView>
                        </StackPane>
                        <VBox>
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Administrador" textFill="#1E293B" />
                            <Label style="-fx-font-size: 11px;" text="Recepción" textFill="#94A3B8" />
                        </VBox>
                    </HBox>
                </HBox>

                <HBox spacing="20.0">

                    <VBox maxWidth="Infinity" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: transparent transparent transparent #44778B; -fx-border-width: 0 0 0 5; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 3);" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="HABITACIONES" textFill="#64748B" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane>
                                <Circle fill="#E0EEF3" radius="16.0" />
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="H" textFill="#44778B" />
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblHabitaciones" style="-fx-font-size: 36px; -fx-font-weight: bold;" text="0" textFill="#1E3A4C" />
                        <Label style="-fx-font-size: 12px;" text="Registradas en el hotel" textFill="#94A3B8" />
                    </VBox>

                    <VBox maxWidth="Infinity" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: transparent transparent transparent #2E9E8F; -fx-border-width: 0 0 0 5; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 3);" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="HUÉSPEDES" textFill="#64748B" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane>
                                <Circle fill="#DDF3EF" radius="16.0" />
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="G" textFill="#2E9E8F" />
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblHuespedes" style="-fx-font-size: 36px; -fx-font-weight: bold;" text="0" textFill="#1E3A4C" />
                        <Label style="-fx-font-size: 12px;" text="Clientes registrados" textFill="#94A3B8" />
                    </VBox>

                    <VBox maxWidth="Infinity" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: transparent transparent transparent #D08A3C; -fx-border-width: 0 0 0 5; -fx-border-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 3);" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="RESERVAS" textFill="#64748B" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane>
                                <Circle fill="#F8ECDD" radius="16.0" />
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="R" textFill="#D08A3C" />
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblReservas" style="-fx-font-size: 36px; -fx-font-weight: bold;" text="0" textFill="#1E3A4C" />
                        <Label style="-fx-font-size: 12px;" text="Reservas activas" textFill="#94A3B8" />
                    </VBox>
                </HBox>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                    <VBox maxWidth="Infinity" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 14, 0, 0, 3);" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="24.0" left="26.0" right="26.0" top="24.0" />
                        </padding>

                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión del hotel" textFill="#1E3A4C" />
                        <Label style="-fx-font-size: 13px;" text="Seleccioná una opción del menú para administrar el sistema." textFill="#64748B" wrapText="true" />

                        <Separator opacity="0.5" />

                        <VBox spacing="12.0">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Circle fill="#44778B" radius="4.0" />
                                <VBox>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Habitaciones" textFill="#1E293B" />
                                    <Label style="-fx-font-size: 12px;" text="Registrá, editá y consultá el estado de cada habitación." textFill="#64748B" wrapText="true" />
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Circle fill="#2E9E8F" radius="4.0" />
                                <VBox>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Huéspedes" textFill="#1E293B" />
                                    <Label style="-fx-font-size: 12px;" text="Administrá los datos de contacto de los clientes." textFill="#64748B" wrapText="true" />
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Circle fill="#D08A3C" radius="4.0" />
                                <VBox>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Reservas" textFill="#1E293B" />
                                    <Label style="-fx-font-size: 12px;" text="Creá reservas verificando la disponibilidad para evitar conflictos de fechas." textFill="#64748B" wrapText="true" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox minWidth="260.0" prefWidth="300.0" spacing="12.0" style="-fx-background-color: linear-gradient(to bottom right, #24475A, #44778B); -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.15), 14, 0, 0, 3);">
                        <padding>
                            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                        </padding>

                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="CONTROL DE CONCURRENCIA" textFill="#BFD7E0" />
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Reservas seguras" textFill="WHITE" />
                        <Label style="-fx-font-size: 13px;" text="Las reservas se procesan de forma sincronizada, evitando que dos usuarios reserven la misma habitación al mismo tiempo." textFill="#E2EEF2" wrapText="true" />

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 20;">
                            <padding>
                                <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
                            </padding>
                            <Circle fill="#4ADE80" radius="4.0" />
                            <Label style="-fx-font-size: 12px;" text="Sistema operativo" textFill="WHITE" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
